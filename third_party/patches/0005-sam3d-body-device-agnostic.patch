+    def _apply(self, fn, recurse=True):
+        # The scripted MHR uses float64, which MPS cannot execute; keep it on
+        # its load device (CPU) so the head can run elsewhere.
+        if not torch.cuda.is_available():
+            mhr = self._modules.pop("mhr", None)
+            try:
+                return super()._apply(fn, recurse)
+            finally:
+                if mhr is not None:
+                    self._modules["mhr"] = mhr
+        return super()._apply(fn, recurse)
+
